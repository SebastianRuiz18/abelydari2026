---
// src/components/OpenedEnvelope.astro
---

<div class="opened-envelope-container">
  <img src="/OpenEnvelope/open-back.png" class="layer back" alt="Envelope Back" />

  <div class="photo-wrapper">
    <img src="/OpenEnvelope/inner-photo.jpg" class="layer photo" alt="Wedding Location" />
  </div>

  <img src="/OpenEnvelope/shadow-mask.png" class="layer shadow-mask" alt="Shadow Mask" />

  <img src="/OpenEnvelope/open-front.png" class="layer front" alt="Envelope Front" />

  <img src="/monogram.png" class="layer monogram" alt="Monogram" />
</div>

<style>
  .opened-envelope-container {
    position: relative;
    width: 100%;
    max-width: 650px; 
    margin: 0 auto;
  }

  .layer {
    display: block;
  }

  .back {
    position: relative;
    width: 100%;
    height: auto;
    z-index: 1;
  }

  .front, .shadow-mask {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .shadow-mask {
    z-index: 3;
    pointer-events: none;
    mix-blend-mode: multiply; 
    opacity: 0.85;
    clip-path: inset(0px 1% 1% 1%);
  }

  .front {
    z-index: 4;
    pointer-events: none;
  }
  
  .photo-wrapper {
    position: absolute;
    z-index: 2;
    top: 8%;
    left: 5%;
    width: 90%;
    height: 75%;
    
    -webkit-mask-image: url('/OpenEnvelope/open-back.png');
    -webkit-mask-size: 100% 100%;
    -webkit-mask-position: center;
    -webkit-mask-repeat: no-repeat;
    
    mask-image: url('/OpenEnvelope/open-back.png');
    mask-size: 100% 100%;
    mask-position: center;
    mask-repeat: no-repeat;
    
    overflow: hidden;
  }

  .photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .monogram {
    position: absolute;
    z-index: 4;
    bottom: 5%;
    left: 50%;
    transform: translateX(-50%);
    width: 20%; 
  }
</style>