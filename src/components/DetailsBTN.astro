---
---

<a href="/details" class="details-btn-wrapper">
  <div class="text-content">
    <h2 class="details-title">Detalles</h2>
    <img src="/DetailsBTN/Birds.png" alt="Pájaros decorativos" class="birds-img" />
    <p class="click-here">Clic Aquí</p>
  </div>
  <img src="/DetailsBTN/Flower.png" alt="Decoración floral" class="flower-img" />
</a>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Pinyon+Script&family=Montserrat:wght@500;600&display=swap');

  .details-btn-wrapper {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    max-width: 400px;
    aspect-ratio: 1 / 1;
    margin: 0 auto;
    text-decoration: none;
    transition: transform 0.3s ease;
    cursor: pointer;
    border-radius: 50%;
  }

  .details-btn-wrapper:hover {
    transform: scale(1.03);
  }

  .flower-img {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 85%;
    height: auto;
    display: block;
    z-index: 1;
    pointer-events: none;
  }

  .birds-img {
    width: 25%;
    height: auto;
    display: block;
    margin: 0 auto;
    z-index: 2;
    pointer-events: none;
    filter: brightness(0) invert(1);
  }

  .text-content {
    position: relative;
    z-index: 3;
    text-align: center;
    top: -3%;
  }

  .details-title {
    font-family: 'Pinyon Script', cursive;
    color: #ffffff;
    font-size: 3rem;
    font-weight: 400;
    line-height: 1;
    margin: 0;
    text-shadow: 0px 2px 4px rgba(0, 0, 0, 0.3);
  }

  .click-here {
    font-family: 'Montserrat', sans-serif;
    color: #ffffff;
    font-size: 0.8rem;
    letter-spacing: 3px;
    font-weight: 400;
    text-transform: uppercase;
    margin: 0;
    text-shadow: 0px 1px 3px rgba(0, 0, 0, 0.5);
  }

  @media (max-width: 600px) {
    .details-title {
      font-size: 9.5vw;
    }

    .click-here {
      font-size: 2.5vw;
      letter-spacing: 0.6vw;
    }
  }
</style>