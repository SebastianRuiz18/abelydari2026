---
// src/components/Polaroid.astro
const { 
  imgSrc, 
  altText = "Polaroid photo", 
  rotation = "0deg" // Valor por defecto si no le pasamos rotación
} = Astro.props;
---

<div class="polaroid-wrapper" style={`transform: rotate(${rotation});`}>
  <img src={imgSrc} alt={altText} class="polaroid-photo" />
  
  <img src="/Polaroid/polaroidframe.png" alt="Marco Polaroid" class="polaroid-frame" />
</div>

<style>
  .polaroid-wrapper {
    position: relative;
    display: inline-block;
    width: 100%;
    filter: drop-shadow(0px 10px 15px rgba(0, 0, 0, 0.15));
    transition: transform 0.3s ease;
  }

  .polaroid-frame {
    position: relative;
    width: 100%;
    height: auto;
    display: block;
    z-index: 2;
    pointer-events: none;
  }

  .polaroid-photo {
    position: absolute;
    z-index: 1;
    object-fit: cover;
    top: 6%;
    left: 6%;
    width: 88%;
    height: 75%; 
  }
</style>