---
// src/components/StoryBTN.astro
import Polaroid from './Polaroid.astro';
---

<a href="/story" class="story-btn-wrapper">
  
  <img src="/storyBTN/OSholder.png" alt="Arco Invitacion" class="frame-img" />

  <div class="content-overlay">
    <h2 class="top-text">La<br/>Invitación</h2>
    
    <div class="polaroid-wrapper">
        <Polaroid imgSrc="/storyBTN/fotoOS.jpg" rotation="0deg" />
    </div>
    
    <p class="click-here">CLIC AQUÍ</p>
  </div>
  
</a>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Pinyon+Script&family=Montserrat:wght@400;500;600&display=swap');

  .story-btn-wrapper {
    position: relative;
    display: block;
    width: 100%;
    margin: 0 auto;
    text-decoration: none;
    transition: transform 0.3s ease;
    cursor: pointer;
  }

  .story-btn-wrapper:hover {
    transform: scale(1.02);
  }

  .frame-img {
    width: 100%;
    height: auto;
    z-index: 1;
  }

  .content-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
  }

  .top-text {
    position: absolute;
    top: 20%;
    left: 60%;
    transform: translateX(-50%);
    
    font-family: 'Pinyon Script', cursive;
    color: #ffffff;
    font-size: 3.2rem; /* Ligeramente más pequeño para que quepa perfecto "Invitación" */
    font-weight: 400;
    line-height: 0.85;
    margin: 0;
    text-align: center;
  }

  .polaroid-wrapper {
    position: absolute;
    top: 65%;
    left: 60%;
    transform: translate(-50%, -50%);
    
    width: 40%;
    pointer-events: none;
  }

  .click-here {
    position: absolute;
    bottom: 8%;
    left: 60%;
    transform: translateX(-50%);
    
    font-family: 'Montserrat', sans-serif;
    color: #ffffff;
    font-size: 0.85rem;
    letter-spacing: 4px;
    font-weight: 500;
    margin: 0;
    white-space: nowrap;
    text-shadow: 0px 1px 3px rgba(0, 0, 0, 0.3);
  }

  @media (max-width: 600px) {
    .top-text {
      font-size: 8.5vw; 
    }

    .click-here {
      font-size: 1.8vw;
      letter-spacing: 1vw;
    }

    .polaroid-wrapper {
      width: 38%;
    }
  }
</style>